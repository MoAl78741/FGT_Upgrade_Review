# Portainer stack environment variables
# These values are loaded automatically when deploying via Repository in Portainer.
# Edit them in the Portainer UI under "Environment variables" after the first deploy.

HOST_PORT=8001
DB_PATH=/app/data/fgt_upgrade.db
# CORS_ORIGINS=* allows all — restrict to e.g. http://192.168.1.12:8001 if needed
CORS_ORIGINS=*
